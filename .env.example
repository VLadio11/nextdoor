# ============================================================
# Nextdoor Monitor — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ----------------------------------------------------------
# Database
# Node.js backend uses:  postgresql://user:pass@host:port/db
# Python/Docker uses:    postgresql+asyncpg://user:pass@host:port/db
#   (the Node.js backend auto-strips the "+asyncpg" prefix if present)
#
# Quick local setup (requires PostgreSQL running):
#   createuser -s nextdoor
#   createdb -O nextdoor nextdoor
#   # then set DATABASE_URL below and run: node src/migrate.js
#
# Leave blank to use the in-memory mock store (no DB needed).
# ----------------------------------------------------------
DATABASE_URL=postgresql://nextdoor:nextdoor@localhost:5432/nextdoor

# ----------------------------------------------------------
# Nextdoor Official Search API
#
# Apply for access at: https://developer.nextdoor.com
# Contact:             partnerships@nextdoor.com
#
# Until approved, set SIM_MODE=true to use the built-in
# post simulator. No API calls are made in simulation mode.
# ----------------------------------------------------------
NEXTDOOR_API_KEY=your_nextdoor_client_id_here
NEXTDOOR_API_SECRET=your_nextdoor_client_secret_here

# Set to false once you have approved API credentials
SIM_MODE=true

# ----------------------------------------------------------
# Email — SMTP configuration
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your_app_password   (use App Passwords, not your account password)
#
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=your_sendgrid_api_key
#
# AWS SES example:
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USER=your_ses_smtp_user
#   SMTP_PASSWORD=your_ses_smtp_password
# ----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=Nextdoor Monitor <alerts@yourdomain.com>
SMTP_USE_TLS=true

# ----------------------------------------------------------
# Polling
# ----------------------------------------------------------
# How often to poll (seconds). Default: 300 (5 minutes).
POLL_INTERVAL_SECONDS=300

# Max Nextdoor API requests per minute (rate limit compliance).
NEXTDOOR_REQUESTS_PER_MINUTE=10

# ----------------------------------------------------------
# App
# ----------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins for the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
